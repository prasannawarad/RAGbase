# Server-only (used by /api/embed and /api/chat). Never expose with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Supabase project URL for server routes. If unset, falls back to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Supabase — REQUIRED. Safe to expose: all data access is protected by Row Level Security and
# runs as the logged-in user (see docs/ARCHITECTURE.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — admin SCRIPTS ONLY (npm run reembed). It bypasses RLS: the web app
# never uses it. Never prefix with NEXT_PUBLIC_ and never import it from src/.
SUPABASE_SERVICE_ROLE_KEY=

# Eval harness (npm run eval) signs in as this account. It must own the documents your
# golden dataset asks about. Use a dedicated account, not your personal one.
EVAL_EMAIL=
EVAL_PASSWORD=

# Groq — primary LLM (Llama 3.3 70B). Server-only.
GROQ_API_KEY=
# Optional model override (free-tier token budgets are per-model), e.g. openai/gpt-oss-120b
GROQ_MODEL=

# API abuse guard (optional). Comma-separated extra origins allowed to call the API
# routes, e.g. a custom domain. The deployment's own host (Vercel VERCEL_URL /
# VERCEL_PROJECT_PRODUCTION_URL) and localhost-in-dev are always allowed, so leave
# blank unless you serve the app from a domain Vercel doesn't set automatically.
ALLOWED_ORIGINS=

# Langfuse observability (optional — tracing is a no-op when unset).
# Free account: https://cloud.langfuse.com — create a project, copy the keys.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Override for self-hosted or EU region (default: https://cloud.langfuse.com)
LANGFUSE_BASEURL=
