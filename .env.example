# Server-only (used by /api/embed and /api/chat). Never expose with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Supabase — server / API routes only (never NEXT_PUBLIC_; never import in "use client")
# If SUPABASE_URL is unset, the server falls back to NEXT_PUBLIC_SUPABASE_URL (same project URL).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — browser only (safe to expose; use with RLS). Optional until client uses Supabase directly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq — primary LLM (Llama 3.3 70B). Server-only.
GROQ_API_KEY=
# Optional model override (free-tier token budgets are per-model), e.g. openai/gpt-oss-120b
GROQ_MODEL=

# Langfuse observability (optional — tracing is a no-op when unset).
# Free account: https://cloud.langfuse.com — create a project, copy the keys.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# Override for self-hosted or EU region (default: https://cloud.langfuse.com)
LANGFUSE_BASEURL=
